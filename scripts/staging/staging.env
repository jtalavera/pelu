# shellcheck shell=bash
# Non-secret constants shared by the scripts/staging/* scripts (docs/staging-env.md).
# Sourced, never executed. Secrets come from the operator's environment, never from this file.

STAGING_SUBSCRIPTION_ID="677a6eab-1283-48ee-a110-f40cf4a6df42"
PROD_SUBSCRIPTION_ID="9e394b80-19d1-4187-8382-31d052ffd540"

STAGING_RG="femme-staging-rg"
PROD_RG="femme-prod-rg"
DEV_RG="femme-test-rg"

# Names that main.tf derives from name_prefix (no random suffix).
CONTAINER_APP_NAME="femme-backend"
SQL_DB_NAME="femme_app_db"

# GitHub
GH_REPO="jtalavera/pelu"
GH_ENVIRONMENT="v2-staging"

# Persistent, private storage OUTSIDE the disposable RG (created by bootstrap.sh).
# Storage account names are global: if bootstrap.sh reports the name is taken, change it here.
STAGING_DATA_RG="femme-staging-data-rg"
STAGING_DATA_ACCOUNT="stfemmestagingdata"
STAGING_DATA_LOCATION="centralus"
SNAPSHOT_CONTAINER="snapshots"          # sanitized-before-use prod BACPACs, expire after 7 days
LOADTEST_CONTAINER="loadtest"           # golden load-test BACPACs + their users JSON, no expiry
REPORTS_CONTAINER="loadtest-reports"    # k6 JSON/HTML reports (never public workflow artifacts)
STATE_CONTAINER="state"                 # sifen-numbering.json (SIFEN high-water mark)
SNAPSHOT_RETENTION_DAYS=7

# Entra group allowed to touch staging data (also the SQL Entra admin).
SQL_ADMINS_GROUP_OBJECT_ID="53c652ae-0159-4a39-9a38-b7444c89156e"
# CI app registration used by deploy-v2.yml for v2-test (and v2-staging).
CI_APP_CLIENT_ID="b4c8fc1a-f6d9-4c56-981e-81db5bf8f7ab"

# SIFEN numbering for load-test tenants that share Femme Coiffure's RUC/timbrado (T6).
SIFEN_DEV_TENANT_NAME="Femme Coiffure"
SIFEN_BLOCK_SIZE=100
SIFEN_NUMBER_FLOOR=1000000     # staging blocks never start below this (dev grows from the bottom)
SIFEN_NUMBER_MARGIN=1000
SIFEN_NUMBER_MAX=9999999       # 7-digit dNumDoc

# Sanitization: rewritten contact data (RFC 2606 .invalid — undeliverable by construction).
SANITIZED_EMAIL_DOMAIN="example.invalid"
SANITIZED_PHONE="0000000000"
